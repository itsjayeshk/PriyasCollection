<% layout("/layouts/boilerplate") -%>

<%
    const productImageUrl =
        product.image && product.image.url ? product.image.url : "/images/logo.png";
    const userOwnsProduct =
        currUser && product.owner && currUser._id.equals(product.owner._id);
%>

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-7">
            <img
                src="<%= productImageUrl %>"
                class="product-detail-img shadow-sm"
                alt="<%= product.title %>"
            >
        </div>

        <div class="col-lg-5">
            <p class="text-uppercase text-muted fw-semibold mb-2">
                <%= product.category %>
            </p>
            <h1 class="fw-bold mb-3"><%= product.title %></h1>
            <p class="product-detail-price fw-bold mb-4">
                Rs. <%= product.price.toLocaleString("en-IN") %>
            </p>

            <% if (userOwnsProduct) { %>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a
                        href="/listings/<%= product._id %>/edit"
                        class="btn btn-dark"
                    >
                        Edit Product
                    </a>

                    <form
                        method="POST"
                        action="/listings/<%= product._id %>?_method=DELETE"
                    >
                        <button type="submit" class="btn btn-danger">
                            Delete Product
                        </button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>

    <hr class="my-5">

    <section class="row">
        <div class="col-lg-8">
            <h2 class="h4 fw-bold mb-4">Customer Reviews</h2>

            <% if (currUser) { %>
                <form
                    action="/listings/<%= product._id %>/reviews"
                    method="POST"
                    novalidate
                    class="needs-validation review-form mb-5"
                >
                    <div class="mb-3">
                        <label class="form-label d-block">Rating</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="rating-5" name="review[rating]" value="5" required>
                            <label for="rating-5" title="5 stars"></label>
                            <input type="radio" id="rating-4" name="review[rating]" value="4" required>
                            <label for="rating-4" title="4 stars"></label>
                            <input type="radio" id="rating-3" name="review[rating]" value="3" required>
                            <label for="rating-3" title="3 stars"></label>
                            <input type="radio" id="rating-2" name="review[rating]" value="2" required>
                            <label for="rating-2" title="2 stars"></label>
                            <input type="radio" id="rating-1" name="review[rating]" value="1" required>
                            <label for="rating-1" title="1 star"></label>
                        </fieldset>
                        <div class="invalid-feedback">
                            Please choose a rating.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="comment" class="form-label">Review</label>
                        <textarea
                            name="review[comment]"
                            id="comment"
                            class="form-control"
                            rows="4"
                            required
                        ></textarea>
                        <div class="invalid-feedback">
                            Please write a review.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-dark">
                        Submit Review
                    </button>
                </form>
            <% } else { %>
                <p class="text-muted">
                    <a href="/users/login">Login</a> to review this product.
                </p>
            <% } %>

            <% if (product.reviews.length === 0) { %>
                <p class="text-muted">No reviews yet.</p>
            <% } %>

            <div class="row g-3">
                <% product.reviews.forEach((review) => { %>
                    <%
                        const reviewAuthor =
                            review.author && review.author.username
                                ? review.author.username
                                : "Customer";
                        const canDeleteReview =
                            currUser &&
                            review.author &&
                            currUser._id.equals(review.author._id);
                    %>
                    <div class="col-md-6">
                        <article class="review-card border rounded-3 p-3 h-100">
                            <div class="d-flex justify-content-between gap-3 mb-2">
                                <h3 class="h6 fw-bold mb-0"><%= reviewAuthor %></h3>
                                <span
                                    class="starability-result"
                                    data-rating="<%= review.rating %>"
                                    aria-label="<%= review.rating %> star rating"
                                ></span>
                            </div>

                            <p class="mb-3"><%= review.comment %></p>

                            <% if (canDeleteReview) { %>
                                <form
                                    method="POST"
                                    action="/listings/<%= product._id %>/reviews/<%= review._id %>?_method=DELETE"
                                >
                                    <button class="btn btn-sm btn-outline-danger">
                                        Delete Review
                                    </button>
                                </form>
                            <% } %>
                        </article>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>
</div>
