<% layout("/layouts/boilerplate") -%>

<section class="collection-header py-4">
    <div>
        <p class="text-uppercase text-muted fw-semibold mb-2">Priya's Collection</p>
        <h1 class="fw-bold mb-2">Products</h1>
        <p class="text-muted mb-0">Rakhis and Poshaks curated for festive gifting.</p>
    </div>
</section>

<section class="filters-container shadow-sm p-4 rounded-3 mb-5">
    <form method="GET" action="/listings">
        <div class="row g-3 align-items-end">
            <div class="col-lg-7 col-md-12">
                <label class="form-label fw-semibold" for="search">Search Products</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input
                        type="text"
                        class="form-control border-start-0 shadow-none"
                        id="search"
                        name="search"
                        placeholder="Search by product name"
                        value="<%= searchQuery %>"
                    >
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <label class="form-label fw-semibold" for="category">Category</label>
                <select name="category" id="category" class="form-select">
                    <option value="">All Products</option>
                    <% categories.forEach((category) => { %>
                        <option
                            value="<%= category %>"
                            <%= selectedCategory === category ? "selected" : "" %>
                        >
                            <%= category %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="col-lg-2 col-md-6 d-grid">
                <button type="submit" class="btn filter-btn">Search</button>
            </div>
        </div>
    </form>
</section>

<section class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
    <% if (products.length === 0) { %>
        <div class="col-12">
            <div class="empty-state text-center p-5 rounded-3">
                <h2 class="h4 fw-bold mb-2">No products found</h2>
                <p class="text-muted mb-0">Try a different search or category.</p>
            </div>
        </div>
    <% } %>

    <% products.forEach((product) => { %>
        <%
            const productImageUrl =
                product.image && product.image.url ? product.image.url : "/images/logo.png";
        %>

        <div class="col">
            <a href="/listings/<%= product._id %>" class="product-link text-decoration-none">
                <article class="card product-card h-100 border-0 shadow-sm overflow-hidden">
                    <img
                        src="<%= productImageUrl %>"
                        class="card-img-top product-card-img"
                        alt="<%= product.title %>"
                    >

                    <div class="card-body product-card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <h2 class="h5 fw-bold text-dark mb-1">
                                    <%= product.title %>
                                </h2>
                                <p class="text-muted mb-0">
                                    <%= product.category %>
                                </p>
                            </div>
                            <p class="product-price fw-bold mb-0">
                                Rs. <%= product.price.toLocaleString("en-IN") %>
                            </p>
                        </div>
                    </div>
                </article>
            </a>
        </div>
    <% }) %>
</section>
