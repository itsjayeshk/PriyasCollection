<% layout("/layouts/boilerplate") -%>

<div class="row py-5">
    <div class="col-lg-8 offset-lg-2">
        <h1 class="h2 fw-bold mb-4">Add Product</h1>

        <form
            method="POST"
            action="/listings"
            enctype="multipart/form-data"
            novalidate
            class="needs-validation product-form"
        >
            <div class="mb-3">
                <label for="title" class="form-label">Product Title</label>
                <input
                    name="product[title]"
                    id="title"
                    type="text"
                    class="form-control"
                    placeholder="Enter product title"
                    required
                >
                <div class="invalid-feedback">Product title is required.</div>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Product Image</label>
                <input
                    name="image"
                    id="image"
                    type="file"
                    class="form-control image-upload-input"
                    accept="image/jpeg,image/png,image/webp"
                    data-preview-target="productImagePreview"
                    required
                >
                <img
                    id="productImagePreview"
                    class="upload-preview d-none"
                    alt="Selected product preview"
                >
                <div class="invalid-feedback">
                    Upload a JPG, JPEG, PNG, or WEBP product image.
                </div>
            </div>

            <div class="mb-3">
                <label for="price" class="form-label">Price</label>
                <input
                    name="product[price]"
                    id="price"
                    type="number"
                    class="form-control"
                    placeholder="Enter price"
                    min="1"
                    required
                >
                <div class="invalid-feedback">Price is required.</div>
            </div>

            <div class="mb-4">
                <label for="category" class="form-label">Category</label>
                <select
                    name="product[category]"
                    id="category"
                    class="form-select"
                    required
                >
                    <option value="">Select Category</option>
                    <% categories.forEach((category) => { %>
                        <option value="<%= category %>"><%= category %></option>
                    <% }) %>
                </select>
                <div class="invalid-feedback">Please select a category.</div>
            </div>

            <button type="submit" class="btn btn-dark add-btn mb-5">
                Add Product
            </button>
        </form>
    </div>
</div>
