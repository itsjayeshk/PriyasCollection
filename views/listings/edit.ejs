<% layout("/layouts/boilerplate") -%>

<%
    const currentImageUrl =
        product.image && product.image.url ? product.image.url : "/images/logo.png";
%>

<div class="row py-5">
    <div class="col-lg-8 offset-lg-2">
        <h1 class="h2 fw-bold mb-4">Edit Product</h1>

        <form
            method="POST"
            action="/listings/<%= product._id %>?_method=PUT"
            enctype="multipart/form-data"
            novalidate
            class="needs-validation product-form"
        >
            <div class="mb-3">
                <label for="title" class="form-label">Product Title</label>
                <input
                    name="product[title]"
                    id="title"
                    value="<%= product.title %>"
                    type="text"
                    class="form-control"
                    placeholder="Enter product title"
                    required
                >
                <div class="invalid-feedback">Product title is required.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Current Image</label>
                <img
                    src="<%= currentImageUrl %>"
                    class="upload-preview current-image-preview"
                    alt="<%= product.title %>"
                >
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Replace Image</label>
                <input
                    name="image"
                    id="image"
                    type="file"
                    class="form-control image-upload-input"
                    accept="image/jpeg,image/png,image/webp"
                    data-preview-target="productImagePreview"
                >
                <img
                    id="productImagePreview"
                    class="upload-preview d-none"
                    alt="Selected product preview"
                >
                <div class="form-text">Leave empty to keep the current image.</div>
                <div class="invalid-feedback">
                    Upload a JPG, JPEG, PNG, or WEBP product image.
                </div>
            </div>

            <div class="mb-3">
                <label for="price" class="form-label">Price</label>
                <input
                    name="product[price]"
                    id="price"
                    value="<%= product.price %>"
                    type="number"
                    min="1"
                    class="form-control"
                    placeholder="Enter price"
                    required
                >
                <div class="invalid-feedback">Price is required.</div>
            </div>

            <div class="mb-4">
                <label for="category" class="form-label">Category</label>
                <select
                    name="product[category]"
                    id="category"
                    class="form-select"
                    required
                >
                    <option value="">Select Category</option>
                    <% categories.forEach((category) => { %>
                        <option
                            value="<%= category %>"
                            <%= product.category === category ? "selected" : "" %>
                        >
                            <%= category %>
                        </option>
                    <% }) %>
                </select>
                <div class="invalid-feedback">Please select a category.</div>
            </div>

            <button type="submit" class="btn btn-dark">
                Update Product
            </button>
        </form>
    </div>
</div>
